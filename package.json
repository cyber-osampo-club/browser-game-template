{
  "name": "pnpm-biome-template",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@11.9.0+sha512.bd682d5d03fe525ef7c9fd6780c6884d1e756ac4c9c9fe00c538782824310dcf90e3ddc4f53835f06dfaebd5085e41855e0bcbb3b60de2ac5bbab89e5036f03b",
  "scripts": {
    "dev": "pnpm codegen && concurrently -k -n client,server -c auto \"pnpm dev:client\" \"pnpm dev:server\"",
    "dev:client": "vite",
    "dev:server": "tsx watch src/server/main.ts",
    "codegen": "panda codegen",
    "build": "pnpm codegen && pnpm build:client && pnpm build:server",
    "build:client": "vite build",
    "build:server": "tsc -p tsconfig.build.json",
    "start": "NODE_ENV=production node dist/server/main.js",
    "test": "pnpm codegen && vitest run",
    "test:cov": "pnpm codegen && vitest run --coverage",
    "bench": "vitest bench",
    "fmt": "biome format --write .",
    "fmt:check": "biome format .",
    "lint": "biome lint .",
    "check": "biome check . && pnpm typecheck",
    "typecheck": "pnpm codegen && tsc -b",
    "release-check": "biome ci . && pnpm typecheck && vitest run",
    "scan:secrets": "pnpm exec secretlint \"**/*\""
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.2",
    "@pandacss/dev": "^1.11.4",
    "@secretlint/secretlint-rule-preset-recommend": "^8.5.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "@vitest/coverage-v8": "^3.2.6",
    "concurrently": "^10.0.3",
    "happy-dom": "^20.10.6",
    "secretlint": "^8.5.0",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "vite": "^8.1.3",
    "vitest": "^3.2.6"
  },
  "dependencies": {
    "@ark-ui/react": "^5.37.2",
    "@hono/node-server": "^2.0.8",
    "@tanstack/react-router": "^1.170.17",
    "hono": "^4.12.27",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  }
}
